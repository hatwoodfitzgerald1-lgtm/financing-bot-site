---
interface Props { active: string }
const { active } = Astro.props;
const links = [
  ['/product', 'How it works', '0001'],
  ['/pricing', 'Pricing', '0002'],
  ['/drafter', 'Condition drafter', '0003'],
  ['/about', 'About', '0004'],
  ['/blog', 'Blog', '0005'],
  ['/contact', 'Contact', '0006'],
];
---
<header class="nav" id="nav">
  <a class="cell wordmark" href="/" aria-label="Financing Bot, home">
    <svg viewBox="0 0 40 40" aria-hidden="true"><g stroke="currentColor" fill="none"><rect x="0.625" y="0.625" width="38.75" height="38.75" stroke-width="1.25"/><g transform="translate(4 8)" stroke-width="1.25" stroke-linecap="square"><path d="M6 3v18"/><path d="M12 3v18"/><path d="M18 3v18"/><path d="M24 3v18"/><path d="M2 20L28 4"/></g></g></svg>
    <span>Financing Bot</span>
  </a>
  <nav class="cells links" aria-label="Primary">
    {links.map(([href, label, ri]) => (
      <a class:list={['cell', { on: active === href }]} href={href} aria-current={active === href ? 'page' : undefined}>
        {active === href && <span class="ri">{ri}</span>}
        <span>{label}</span><i class="tick"></i>
      </a>
    ))}
  </nav>
  <div class="cells right">
    <button class="cell menu-cell" type="button" id="menu-btn" aria-expanded="false" aria-controls="menu-panel">
      <svg class="icon" id="menu-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square"><line x1="3" y1="6" x2="21" y2="6"/><line class="menu2" x1="3" y1="12" x2="17" y2="12"/><line class="menu3" x1="3" y1="18" x2="13" y2="18"/></svg>
      <span>Menu</span>
    </button>
    <a class="cell cart-cell" href="/cart" id="cart-cell" aria-label="Cart, 0 lines">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square"><path d="M3 9h18l-2 11H5z"/><rect x="14" y="2" width="7" height="5"/></svg>
      <span>Cart <span class="drum" id="cart-count" data-drum="0">0</span></span>
    </a>
  </div>
</header>
<style>
  #menu-icon .menu2, #menu-icon .menu3 { transition: opacity var(--fast) var(--ra), transform var(--fast) var(--ra); }
  .menu-cell[aria-expanded="true"] #menu-icon .menu2 { opacity: 0; }
  .menu-cell[aria-expanded="true"] #menu-icon .menu3 { transform: translateY(-6px); }
</style>
