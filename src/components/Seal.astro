---
interface Props { size?: number }
const { size = 96 } = Astro.props;
---
<svg class="seal" viewBox="0 0 96 96" width={size} height={size} fill="none" stroke="#E9E5DA" stroke-width="1.25" role="img" aria-label="Prepared, calculated, documented. Decided by the underwriter of record.">
  <rect x="2" y="2" width="92" height="92"/>
  <rect x="6" y="6" width="84" height="84"/>
  <g font-family="'Fragment Mono', monospace" font-size="5.2" fill="#E9E5DA" stroke="none" letter-spacing="0.6">
    <text x="48" y="15.5" text-anchor="middle">PREPARED</text>
    <text x="48" y="87" text-anchor="middle" font-size="3.9">DECIDED BY THE UNDERWRITER OF RECORD</text>
    <text transform="translate(15 48) rotate(-90)" text-anchor="middle">CALCULATED</text>
    <text transform="translate(81 48) rotate(90)" text-anchor="middle">DOCUMENTED</text>
  </g>
  <line x1="20" y1="22" x2="76" y2="22"/>
  <line x1="20" y1="74" x2="76" y2="74"/>
  <g transform="translate(32 34)" stroke-linecap="square">
    <path d="M6 3v18"/><path d="M12 3v18"/><path d="M18 3v18"/><path d="M24 3v18"/><path d="M2 20L28 4"/>
  </g>
  <rect x="34" y="60" width="28" height="9"/>
  <text x="48" y="66.6" text-anchor="middle" font-family="'Fragment Mono', monospace" font-size="4.6" fill="#E9E5DA" stroke="none">LN 2026</text>
</svg>
