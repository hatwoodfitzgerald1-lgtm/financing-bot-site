  .abacus-2d .ab::after { content: ''; grid-column: 2; grid-row: 1; height: 10px; border: var(--hair) solid var(--paper); width: calc(var(--w) * 1%); transform: scaleX(0); transform-origin: left; transition: transform var(--slow) var(--cr); }
  .abacus-2d .ab b { font-weight: 400; color: var(--paper); grid-column: 3; grid-row: 1; }
  .abacus-2d .ab span { grid-column: 1; grid-row: 1; }
  .abacus-2d .ab.neg::after { border-style: dashed; }
  .abacus-2d .ab.sum::after { background: var(--paper); }
  .scene.is-2d.in .abacus-2d .ab::after { transform: none; }
</style>
